@model IEnumerable<project_a.Models.TaskModel>
@{
    ViewData["Title"] = "1. Bölüm: Temel Etkileşimler - Püskül";
}

<div class="container py-4 py-md-5">
    <!-- Üst Başlık & Gezinme Çubuğu -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <a href="/" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold small d-inline-flex align-items-center gap-1">
                <span>◀</span> <span>Ana Sayfa</span>
            </a>
            <div>
                <h2 class="fw-black text-dark mb-0">🎯 1. Bölüm: Temel Etkileşimler</h2>
                <p class="text-muted small mb-0">Püskül ile dokun, sürükle, parçaları birleştir ve ilk algoritmik ritimlerini oluştur!</p>
            </div>
        </div>
        <div>
            <a href="/Atolye" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1.5 fw-bold">
                🧪 Serbest Atölye'ye Git ➔
            </a>
        </div>
    </div>

    <!-- 10 GÖREVİN LİSTESİ (2-3 SÜTUNLU RESPONSIVE IZGARA) -->
    <div class="row g-3 g-md-4">
        @foreach (var task in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-3 position-relative overflow-hidden transition-all hover-lift"
                     style="background: #FFFFFF; border: 1.5px solid #E2E8F0 !important;">
                    
                    <!-- Kart Üst Çubuğu: Görev Numarası ve İkon -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge rounded-pill px-2.5 py-1 text-white fw-bold small" style="background: @task.ColorTheme;">
                            Görev @task.Id
                        </span>
                        <span class="fs-3">@task.Icon</span>
                    </div>

                    <!-- Görev Başlığı -->
                    <h5 class="fw-bold text-dark mb-2">@task.Title</h5>

                    <!-- Çocuk Dostu 2 Cümlelik Kısa Hikaye / Açıklama -->
                    <p class="text-secondary small mb-3 flex-grow-1" style="line-height: 1.45;">
                        @task.Description
                    </p>

                    <!-- Alt Eylem Butonu -->
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                        <span class="text-muted" style="font-size: 0.8rem;">
                            🎵 @task.SoundInfo.Split('.')[0]
                        </span>
                        <a href="/Gorev/@task.Id" class="btn btn-sm px-3 py-1.5 rounded-pill fw-bold text-white shadow-sm"
                           style="background: @task.ColorTheme;">
                            <span>Oyna ▶</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
