@model IEnumerable<project_a.Models.TaskModel>
@{
    int chapterId = ViewData["ChapterId"] as int? ?? 0;
    string chapterTitle = ViewData["ChapterTitle"] as string ?? "Püskül'ün Macera Patikası";
    string chapterDesc = ViewData["ChapterDescription"] as string ?? "1'den başlayıp sona uzanan renkli yolu takip et!";
    ViewData["Title"] = $"{chapterTitle} - Püskül";
}

<div class="adventure-page-wrapper py-4 py-md-5">
    <div class="container">
        <!-- Üst Başlık & Geri Dönüş -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <a href="/" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold small d-inline-flex align-items-center gap-1 shadow-sm">
                    <span>◀</span> <span>Ana Sayfa</span>
                </a>
                <div>
                    <h2 class="fw-black text-dark mb-0 fs-3">@chapterTitle</h2>
                    <p class="text-muted small mb-0">@chapterDesc</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill bg-primary px-3 py-2 fw-bold text-white shadow-sm">
                    ✨ Toplam @Model.Count() Görev
                </span>
            </div>
        </div>

        <!-- İNTERAKTİF, ÇOK RENKLİ, KAYDIRILABİLİR KIVRIMLI MACERA YOLU -->
        <div class="adventure-scroll-stage">
            <div class="adventure-map-container position-relative">
                <div class="adventure-map-header text-center mb-5">
                    <span class="badge rounded-pill px-4 py-2 fw-black fs-5 shadow-sm text-white" 
                          style="background: linear-gradient(135deg, #EC4899, #8B5CF6);">
                        🌈 BÜYÜLÜ KODLAMA PATİKASI
                    </span>
                    <p class="text-secondary fw-semibold small mt-2">
                        Her renk yeni bir bilgi, her görev yeni bir ritim! Patikayı takip et ve Püskül'e yol göster.
                    </p>
                </div>

                <!-- Patika Akışı (Winding S-Curve Road) -->
                <div class="adventure-path-flow" id="adventurePathFlow">
                    @{
                        int index = 0;
                        string[] palette = new string[] {
                            "linear-gradient(135deg, #6366F1, #4F46E5)", // Indigo
                            "linear-gradient(135deg, #EC4899, #DB2777)", // Pink
                            "linear-gradient(135deg, #10B981, #059669)", // Emerald
                            "linear-gradient(135deg, #F59E0B, #D97706)", // Amber
                            "linear-gradient(135deg, #8B5CF6, #7C3AED)", // Purple
                            "linear-gradient(135deg, #06B6D4, #0891B2)", // Cyan
                            "linear-gradient(135deg, #EF4444, #DC2626)", // Red
                            "linear-gradient(135deg, #14B8A6, #0D9488)", // Teal
                            "linear-gradient(135deg, #F97316, #EA580C)", // Orange
                            "linear-gradient(135deg, #3B82F6, #2563EB)"  // Blue
                        };
                    }
                    @foreach (var task in Model)
                    {
                        string grad = palette[index % palette.Length];
                        int curveStep = index % 4; // 0: left, 1: center-left, 2: right, 3: center-right
                        string curveClass = curveStep switch {
                            0 => "curve-far-left",
                            1 => "curve-mid-left",
                            2 => "curve-far-right",
                            _ => "curve-mid-right"
                        };
                        index++;

                        <div class="adventure-node-wrapper @curveClass" id="taskNode-@task.Id" data-task-id="@task.Id">
                            <!-- Üzerinde süzülen Püskül Maskotu ("Buradasın!") -->
                            <div class="adventure-puskul-indicator" id="puskulIndicator-@task.Id" style="display: none;">
                                <img src="~/img/firca-ziplama.svg" alt="Püskül" class="indicator-puskul-img" />
                                <span class="indicator-bubble">Buradasın! 👋</span>
                            </div>

                            <!-- Görev Düğümü Kartı -->
                            <a href="/Gorev/@task.Id" class="adventure-node-card text-decoration-none" id="taskCard-@task.Id">
                                <div class="node-badge-circle" style="background: @grad;">
                                    <span class="node-number">@task.Id</span>
                                    <span class="node-icon">@task.Icon</span>
                                    <div class="node-lock-badge" id="lockBadge-@task.Id">
                                        🔒
                                    </div>
                                    <div class="node-star-badge" id="starBadge-@task.Id" style="display: none;">
                                        ⭐
                                    </div>
                                </div>

                                <div class="node-info-bubble">
                                    <h6 class="node-title text-dark fw-bold mb-1">@task.Title</h6>
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <span class="node-concept badge rounded-pill px-2.5 py-1 text-white shadow-xs" style="background: @grad;">
                                            @task.ConceptBadge
                                        </span>
                                        <span class="text-muted small" style="font-size: 0.72rem;">
                                            🎵 @task.SoundInfo.Split('.')[0]
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const chapterId = @chapterId;
            const nodes = document.querySelectorAll('.adventure-node-wrapper');
            const activeTaskId = window.ProgressManager 
                ? window.ProgressManager.getActiveTaskForChapter(chapterId) 
                : 1;

            let activeNodeElement = null;

            nodes.forEach(node => {
                const taskId = parseInt(node.getAttribute('data-task-id'), 10);
                const isCompleted = window.ProgressManager ? window.ProgressManager.isTaskCompleted(taskId) : false;
                const isUnlocked = window.ProgressManager ? window.ProgressManager.isTaskUnlocked(taskId) : (taskId === 1);

                const card = document.getElementById(`taskCard-${taskId}`);
                const lockBadge = document.getElementById(`lockBadge-${taskId}`);
                const starBadge = document.getElementById(`starBadge-${taskId}`);
                const indicator = document.getElementById(`puskulIndicator-${taskId}`);

                if (isCompleted) {
                    node.classList.add('is-completed');
                    if (lockBadge) lockBadge.style.display = 'none';
                    if (starBadge) starBadge.style.display = 'flex';
                } else if (isUnlocked) {
                    node.classList.add('is-unlocked');
                    if (lockBadge) lockBadge.style.display = 'none';
                } else {
                    node.classList.add('is-locked');
                    if (card) {
                        card.setAttribute('tabindex', '-1');
                        card.setAttribute('aria-disabled', 'true');
                        card.addEventListener('click', (e) => {
                            e.preventDefault();
                        });
                    }
                }

                // Aktif görevin üzerinde Püskül göster
                if (taskId === activeTaskId) {
                    node.classList.add('is-active');
                    if (indicator) indicator.style.display = 'flex';
                    activeNodeElement = node;
                }
            });

            // Aktif göreve yumuşak kaydırma (smooth scroll)
            if (activeNodeElement && activeTaskId > 2) {
                setTimeout(() => {
                    activeNodeElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 350);
            }
        });
    </script>
}
