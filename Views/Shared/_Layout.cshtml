<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Püskül</title>
    
    <!-- Google Fonts: Baloo 2 & Nunito (Full Turkish Support: Latin & Latin-Ext) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Site Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["IsTaskPage"] as bool? == true ? "task-page-body" : "")">
    @if (ViewData["IsTaskPage"] as bool? != true)
    {
        <header>
            <nav class="navbar navbar-expand-lg navbar-ritmik">
                <div class="container-fluid px-3 px-md-4">
                    <a class="brand-badge" href="/">
                        <img src="~/img/firca.svg" alt="Püskül Logo" class="brand-logo-img" />
                        <span>Püskül</span>
                    </a>
                    
                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#ritmikNav" aria-controls="ritmikNav" aria-expanded="false" aria-label="Menüyü Aç">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    
                    <div class="collapse navbar-collapse" id="ritmikNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-pill-link" href="/">🏠 Ana Sayfa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-pill-link" href="/Bolum">🗺️ Macera Haritası</a>
                            </li>
                        </ul>
                        
                        <div class="d-flex align-items-center gap-2">
                            <!-- Pentatonik Ses Denetimi -->
                            <button id="audioToggleBtn" class="audio-toggle-btn" type="button" title="Sesi Aç / Kapat">
                                <span id="audioIcon">🔊</span>
                                <span id="audioLabel">Ses: Açık</span>
                            </button>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="flex-grow-1 d-flex flex-column">
        @RenderBody()
    </main>

    @if (ViewData["IsTaskPage"] as bool? != true && ViewData["HideFooter"] as bool? != true)
    {
        <footer>
            <div class="container text-center">
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mb-2">
                    <a href="/" class="text-decoration-none text-muted">Ana Sayfa</a>
                    <span>•</span>
                    <a href="/Bolum" class="text-decoration-none text-muted">Macera Haritası</a>
                </div>
                <p class="mb-0 text-muted">
                    🖌️ <strong>Püskül</strong> &copy; 2026 — 7-14 Yaş İçin Şekil, Renk ve Müzikle Kodlama Platformu.
                </p>
            </div>
        </footer>
    }

    <!-- Temel Kütüphaneler -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/pixi/pixi.min.js" asp-append-version="true"></script>
    <script src="~/js/progress-manager.js" asp-append-version="true"></script>
    <script src="~/js/audio-engine.js" asp-append-version="true"></script>
    <script src="~/js/canvas-engine.js" asp-append-version="true"></script>
    <script src="~/js/pixi-engine.js" asp-append-version="true"></script>
    
    <script>
        // Ses Butonu Senkronizasyonu
        const audioBtn = document.getElementById('audioToggleBtn');
        const audioIcon = document.getElementById('audioIcon');
        const audioLabel = document.getElementById('audioLabel');

        function updateAudioBtnUI(muted) {
            if (audioBtn) {
                if (muted) {
                    audioBtn.classList.add('muted');
                } else {
                    audioBtn.classList.remove('muted');
                }
            }
            if (audioIcon) {
                audioIcon.textContent = muted ? '🔇' : '🔊';
            }
            if (audioLabel) {
                audioLabel.textContent = muted ? 'Ses: Kapalı' : 'Ses: Açık';
            }
        }

        if (audioBtn) {
            audioBtn.addEventListener('click', () => {
                if (window.RhythmMixer) {
                    const isMuted = window.RhythmMixer.toggleMute();
                    updateAudioBtnUI(isMuted);
                    if (!isMuted) {
                        window.RhythmMixer.playNote('Do', 0.2);
                    }
                }
            });

            window.addEventListener('audio-mute-changed', (e) => {
                updateAudioBtnUI(e.detail.muted);
            });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
