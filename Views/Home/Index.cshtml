@model IEnumerable<project_a.Models.TaskModel>
@{
    ViewData["Title"] = "Püskül - Şekil, Renk ve Ritimle Kodlama";
    ViewData["HideFooter"] = true;
}

<div class="hero-home-stage position-relative flex-grow-1 d-flex align-items-center overflow-hidden">
    <!-- ARKA PLANDA UÇUŞAN RİTİM VE KODLAMA BALONCUKLARI (ÇEŞİTLİ, DAHA ÇOK VE HIZLI) -->
    <div class="floating-rhythm-bubbles" aria-hidden="true">
        <span class="bubble bubble-1">🎵</span>
        <span class="bubble bubble-2">⭐</span>
        <span class="bubble bubble-3">▲</span>
        <span class="bubble bubble-4">🎶</span>
        <span class="bubble bubble-5">●</span>
        <span class="bubble bubble-6">✨</span>
        <span class="bubble bubble-7">■</span>
        <span class="bubble bubble-8">🎼</span>
        <span class="bubble bubble-9">🚀</span>
        <span class="bubble bubble-10">🎨</span>
        <span class="bubble bubble-11">🧩</span>
        <span class="bubble bubble-12">⚡</span>
        <span class="bubble bubble-13">🔔</span>
        <span class="bubble bubble-14">🌈</span>
        <span class="bubble bubble-15">🔷</span>
        <span class="bubble bubble-16">🎹</span>
        <span class="bubble bubble-17">🌟</span>
        <span class="bubble bubble-18">🥁</span>
        <span class="bubble bubble-19">💡</span>
        <span class="bubble bubble-20">🕹️</span>
    </div>

    <!-- MASAÜSTÜ İÇİN ARKA PLANDA SAĞDA SABİT DURAN PÜSKÜL YÜZÜ (MOBİLDE GİZLENİR) -->
    <div class="hero-fullscreen-face d-none d-lg-flex" aria-hidden="true">
        <img src="~/img/firca-yuz.svg" alt="" class="hero-fullscreen-face-img" />
    </div>

    <div class="container py-3 py-md-5 position-relative" style="z-index: 2;">
        <div class="hero-giant-text-section py-2 py-lg-4 text-center text-lg-start">
            <div class="row align-items-center">
                <div class="col-lg-8 col-xl-7">
                    <!-- MOBİL EKRANLAR İÇİN ÖZEL PÜSKÜL YÜZÜ ROZETİ (YAZILARIN ÜSTÜNDE, NET VE ORANTILI) -->
                    <div class="hero-mobile-face-badge d-block d-lg-none mb-3">
                        <img src="~/img/firca-yuz.svg" alt="Püskül" class="hero-mobile-face-img" />
                    </div>

                    <!-- DEV BAŞLIK (NET VE SADE KOYU RENK) -->
                    <h1 class="hero-mega-title fw-black mb-3 lh-1 text-dark">
                        Püskül'ün <br />
                        Büyülü Dünyasına <br />
                        Hoş Geldin!
                    </h1>

                    <!-- BÜYÜK VE NET AÇIKLAMA METNİ -->
                    <p class="hero-mega-desc mb-4 fw-medium text-secondary">
                        Canlı renkler, melodiler ve sevimli dostumuz Püskül ile kodlamayı bir oyun gibi keşfetmeye hazır mısın?
                    </p>

                    <!-- DEV EYLEM BUTONU -->
                    <div class="d-flex flex-wrap gap-3 mt-2 justify-content-center justify-content-lg-start">
                        <a href="/Bolum" class="btn-fun-hero-giant shadow-lg px-4 px-md-5 py-3.5 py-md-4 fs-3 text-white text-decoration-none">
                            <span>✨ Eğlenceye Başla! 🚀</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
